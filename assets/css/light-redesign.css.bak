/* ===========================================================================
   LIGHT REDESIGN
   White ground, black type, blue for accent / links / buttons.
   Loaded last, so it inverts mono-theme.css wholesale.

   The navbar stays white (it already was) and the logo goes back to blue.
   =========================================================================== */

:root {
  /* --- surfaces ------------------------------------------------------- */
  --bg:        #ffffff;
  --bg-alt:    #f4f6f9;   /* alternating band */
  --bg-panel:  #ffffff;   /* cards, sitting on a border not a fill */
  --panel-a:   rgba(255, 255, 255, .96);
  --panel-b:   rgba(244, 246, 249, .98);

  /* --- ink -------------------------------------------------------------
     Raised against a straight inversion: black at 35% on white is a ghost,
     where white at 35% on black still reads. */
  --fg:        #0a0a0a;
  --fg-70:     rgba(10, 10, 10, .74);
  --fg-55:     rgba(10, 10, 10, .62);
  --fg-50:     rgba(10, 10, 10, .58);
  --fg-45:     rgba(10, 10, 10, .54);
  --fg-40:     rgba(10, 10, 10, .50);
  --fg-35:     rgba(10, 10, 10, .46);
  --fg-30:     rgba(10, 10, 10, .40);

  --line:      rgba(10, 10, 10, .14);
  --line-soft: rgba(10, 10, 10, .08);

  /* --- blue ------------------------------------------------------------
     #1E6FD9 measures 4.5:1 on white, so it is safe for body-size links.
     The lighter brand blue is kept for fills and graphics only. */
  --accent:      #1E6FD9;
  --accent-deep: #14539F;
  --accent-soft: #3B82C6;
  --accent-15: rgba(30, 111, 217, .10);
  --accent-25: rgba(30, 111, 217, .18);
  --accent-30: rgba(30, 111, 217, .24);
  --accent-70: rgba(30, 111, 217, .60);
  --ok:        #0E7C58;
}

html, body { background: var(--bg) url('../img/whole2bg.jpg') center top / 1600px auto repeat fixed !important; color: var(--fg) !important; }
::selection { background: rgba(30, 111, 217, .18); color: var(--fg); }
:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }

/* --- bands ------------------------------------------------------------ */
.certs, .anatomy, .reach            { background: var(--bg-alt) !important; }
.product, .industries,
.distributor, .roadmap              { background: var(--bg) !important; }

/* --- surfaces --------------------------------------------------------- */
.cert-card, .spec, .view, .country, .form, .zone, .region, .rail__cta {
  background: #ffffff !important;
  border: 1px solid var(--line) !important;
  box-shadow: 0 1px 2px rgba(10,10,10,.04), 0 6px 20px rgba(10,10,10,.05);
}
.rail, .rail__inner                 { background: var(--bg-alt) !important; }
.ticker                             { background: #ffffff !important; border-top: 1px solid var(--line) !important; }
.ticker *                           { color: var(--fg-50) !important; }

/* --- type ------------------------------------------------------------- */
h1, h2, h3, h4, p, li, span, b, i, div, label { color: inherit; }
h1, h2, h3, h4                      { color: var(--fg) !important; }
.accent, h1 .accent, h2 .accent, h3 .accent { color: var(--accent) !important; }
.eyebrow, .hero__meta, .hs__face,
.milestone__when, .zone__tag        { color: var(--accent) !important; }
.hud-t, .spec__head, .spec__cap,
.view__label, .cert-card__id        { color: var(--fg-50) !important; }
.chip, .tag, .cert-card__tag {
  background: var(--accent-15) !important;
  border-color: rgba(30,111,217,.26) !important;
  color: var(--accent-deep) !important;
}
.dot, .dot--ok, .dot--accent        { background: var(--accent) !important; box-shadow: none !important; }
a                                    { color: var(--accent); }
a:hover                              { color: var(--accent-deep); }

/* --- buttons: blue fill / blue outline -------------------------------- */
.btn--solid {
  background: var(--accent) !important; border-color: var(--accent) !important;
  color: #ffffff !important;
}
.btn--solid:hover { background: var(--accent-deep) !important; border-color: var(--accent-deep) !important; }
.btn:not(.btn--solid), .rb-cta {
  background: transparent !important; color: var(--accent) !important;
  border: 1px solid rgba(30,111,217,.40) !important;
}
.btn:not(.btn--solid):hover, .rb-cta:hover {
  background: var(--accent-15) !important; border-color: var(--accent) !important;
}

/* --- forms ------------------------------------------------------------ */
.form input, .form select, .form textarea {
  background: #ffffff !important; border: 1px solid var(--line) !important; color: var(--fg) !important;
}
.form input::placeholder, .form textarea::placeholder { color: var(--fg-40) !important; }
.form input:focus, .form select:focus, .form textarea:focus { border-color: var(--accent) !important; }

/* --- hover states ----------------------------------------------------- */
.spec:hover, .view:hover, .country:hover, .cert-card:hover {
  border-color: var(--accent) !important;
  box-shadow: 0 2px 4px rgba(10,10,10,.05), 0 14px 32px rgba(30,111,217,.12) !important;
}
.sector:hover { border-top-color: var(--accent) !important; }

/* ===========================================================================
   NAVBAR — stays white, type black, logo back to blue
   =========================================================================== */
.nav { background: rgba(255,255,255,.88) !important; backdrop-filter: saturate(180%) blur(18px); border-bottom: 1px solid var(--line) !important; }
.nav a, .nav button, .nav span, .nav b, .nav i { color: var(--fg) !important; }
.nav a { opacity: .76; }
.nav a:hover, .nav a.is-on { opacity: 1; color: var(--accent) !important; }
.nav__logo img, .nav img { filter: none !important; }   /* blue logo restored */
.nav__badge { border-color: rgba(30,111,217,.30) !important; background: var(--accent-15) !important; }
.nav__badge span, .nav__badge b { color: var(--accent-deep) !important; }
.nav__badge .dot { background: var(--accent) !important; }
.nav .btn, .nav .btn--solid, .nav a.btn {
  background: var(--accent) !important; border-color: var(--accent) !important; color: #fff !important;
}
.nav .btn:hover { background: var(--accent-deep) !important; border-color: var(--accent-deep) !important; }
.nav__burger span, .burger span, .nav__toggle span { background: var(--fg) !important; }
.langsw a, .langsw__globe { color: var(--fg-55) !important; }
.langsw a:hover, .langsw a.is-on { color: var(--accent) !important; }
.langsw__menu, .nav__drawer, .mobile-menu { background: #fff !important; border-color: var(--line) !important; }
.langsw__menu a, .nav__drawer a, .mobile-menu a { color: var(--fg) !important; }

/* ===========================================================================
   FOOTER — white too, so the page reads as one sheet
   =========================================================================== */
footer { background: var(--bg-alt) !important; border-top: 1px solid var(--line) !important; }
footer *, footer h2, footer p, footer span, footer b, footer div { color: var(--fg) !important; }
footer a { color: var(--fg-70) !important; }
footer a:hover { color: var(--accent) !important; }
footer .footer__col h2, footer nav[aria-label] { color: var(--accent) !important; }
footer img, footer .nav__logo img { filter: none !important; }
footer .footer__n, footer .legal, footer small { color: var(--fg-50) !important; }
footer .btn--solid { background: var(--accent) !important; color: #fff !important; border-color: var(--accent) !important; }

/* ===========================================================================
   HERO — the sequence inverted
   The plate now washes OUT to white as the aperture closes, so the sequence
   runs from a busy industrial photograph to a clean technical drawing.
   =========================================================================== */
.hero__stage { background: #ffffff !important; }
.hc__media {
  background: radial-gradient(120% 90% at 50% 40%, #ffffff 0%, #f4f6f9 60%, #eceff4 100%) !important;
  /* brightness goes UP, not down: the scene bleaches instead of darkening */
  filter: brightness(calc(1 + var(--hp) * 0.06)) !important;
}
.hc__plate { opacity: calc(.6 - var(--hp) * .6) !important; }
.hc__device { filter: drop-shadow(0 30px 50px rgba(10,10,10,.18)) drop-shadow(0 6px 14px rgba(10,10,10,.10)) !important; }
.hc__device img { filter: contrast(1.10) saturate(1.12); }
.hc__half  { color: var(--fg) !important; }
.hc__half--r { color: var(--accent) !important; }
.hc__meta  { color: var(--accent) !important; }
.hc__meta em { background: rgba(30,111,217,.35) !important; }
.hc__face  { color: var(--accent) !important; }
.hc__desc  { color: var(--fg-70) !important; }
.hc__title { color: var(--fg) !important; }
.hc__lede  { color: var(--fg-70) !important; }
.hc__cue   { color: var(--fg-40) !important; }
.hc__cue span { background: rgba(10,10,10,.25) !important; }

/* ===========================================================================
   ACT 3 — the callout diagram
   Phone front view centred, specs annotated left, right and bottom, each
   with a rule running toward the device. Replaces the tile grid.
   =========================================================================== */
.hc__well { display: none !important; }

.hc__grid {
  grid-template-columns: minmax(150px, 1fr) minmax(190px, auto) minmax(150px, 1fr) !important;
  grid-template-rows: repeat(3, auto) auto !important;
  gap: clamp(10px, 1.6vh, 20px) clamp(18px, 4vw, 64px) !important;
  padding: clamp(96px, 14vh, 150px) clamp(20px, 5vw, 80px) clamp(24px, 4vh, 54px) !important;
  align-content: center !important;
  justify-items: stretch !important;
}

.hc__tile {
  background: transparent !important;
  border: 0 !important;
  border-radius: 0 !important;
  padding: 0 !important;
  position: relative !important;
  box-shadow: none !important;
}
.hc__tile * { color: var(--fg-70) !important; font-size: 13px !important; }
.hc__tile h4, .hc__tile .hud-t {
  font-family: var(--mono) !important; font-size: 11px !important;
  letter-spacing: .18em !important; color: var(--accent) !important;
  margin: 0 0 4px !important;
}
.hc__tile .hud-stage__figure b, .hc__tile .hud-stage__title b, .hc__tile .hud-panel__big {
  font-family: var(--display) !important; font-size: 20px !important;
  font-weight: 700 !important; color: var(--fg) !important; letter-spacing: -.012em !important;
}

/* the connector rules */
.hc__tile::after {
  content: ""; position: absolute; top: 14px;
  height: 1px; background: linear-gradient(90deg, var(--accent-70), rgba(30,111,217,.12));
  width: clamp(20px, 3.2vw, 54px);
}

/* --- left column: 3 items, text right-aligned, rule runs right -------- */
.hc__tile--1 { grid-column: 1; grid-row: 1; --dx: -60px; --dy: -20px; }
.hc__tile--2 { grid-column: 1; grid-row: 2; --dx: -60px; --dy:   0px; }
.hc__tile--3 { grid-column: 1; grid-row: 3; --dx: -60px; --dy:  20px; }
.hc__tile--1, .hc__tile--2, .hc__tile--3 {
  text-align: right; padding-right: clamp(26px, 3.8vw, 62px) !important;
}
.hc__tile--1::after,
.hc__tile--2::after,
.hc__tile--3::after { right: 0; }

/* --- right column: 3 items, text left-aligned, rule runs left --------- */
.hc__tile--4 { grid-column: 3; grid-row: 1; --dx: 60px; --dy: -20px; }
.hc__tile--5 { grid-column: 3; grid-row: 2; --dx: 60px; --dy:   0px; }
.hc__tile--6 { grid-column: 3; grid-row: 3; --dx: 60px; --dy:  20px; }
.hc__tile--4, .hc__tile--5, .hc__tile--6 {
  text-align: left; padding-left: clamp(26px, 3.8vw, 62px) !important;
}
.hc__tile--4::after,
.hc__tile--5::after,
.hc__tile--6::after {
  left: 0; background: linear-gradient(270deg, var(--accent-70), rgba(30,111,217,.12));
}

/* --- bottom: 2 items under the device, rules run up ------------------- */
.hc__tile--7 { grid-column: 2; grid-row: 4; --dx: -24px; --dy: 40px; justify-self: end;   text-align: right; padding-right: 18px !important; }
.hc__tile--8 { grid-column: 2; grid-row: 4; --dx:  24px; --dy: 40px; justify-self: start; text-align: left;  padding-left: 18px !important; }
.hc__tile--7::after,
.hc__tile--8::after {
  top: -12px; left: 50%; transform: translateX(-50%);
  width: 1px; height: 10px;
  background: linear-gradient(180deg, rgba(30,111,217,.12), var(--accent-70));
}

/* the device sits in the middle column, spanning the three label rows */
.hc__media { z-index: 2; }
.hc__grid  { z-index: 6; }

@media (max-width: 900px) {
  .hc__grid {
    grid-template-columns: 1fr 1fr !important;
    grid-template-rows: auto !important;
    padding: 84px 18px 20px !important;
    gap: 14px !important;
  }
  .hc__tile,
  .hc__tile[class*="hc__tile--"] {
    grid-column: auto !important; grid-row: auto !important;
    text-align: left !important; padding: 0 0 0 12px !important;
    justify-self: stretch !important;
    --dx: 0px; --dy: 20px;
  }
  .hc__tile::after {
    top: 4px; left: 0; right: auto; transform: none;
    width: 1px; height: calc(100% - 8px);
    background: linear-gradient(180deg, var(--accent-70), rgba(30,111,217,.12)) !important;
  }
}

@media (prefers-reduced-motion: reduce) {
  .hc__media { filter: none !important; }
  .hc__plate { opacity: .16 !important; }
}

/* ===========================================================================
   ACT 3 — FIXES
   1. text was clipped on both flanks: hero-cinema.css puts overflow:hidden on
      the tiles, and the HUD blocks carry flex rows wider than the box
   2. the bottom pair overlapped: both sat in grid-column 2 / row 4, and that
      column is only ~190px wide
   3. type was too small to read as a spec callout
   =========================================================================== */

/* --- 1. let the tiles size to their content --------------------------- */
.hc__tile {
  overflow: visible !important;
  min-width: 0 !important;
  width: auto !important;
}
.hc__tile > *,
.hc__tile .hud-stage__foot,
.hc__tile .hud-stage__rows,
.hc__tile .hud-panel__rows,
.hc__tile .hud-stage__state,
.hc__tile .hud-panel__state,
.hc__tile .chips {
  overflow: visible !important;
  white-space: normal !important;
  min-width: 0 !important;
}
/* the HUD rows are space-between flex pairs; on a callout they read better
   stacked tight against the alignment edge */
.hc__tile .hud-stage__foot,
.hc__tile .hud-stage__rows > div,
.hc__tile .hud-panel__rows > div {
  display: flex !important; gap: 10px !important;
  justify-content: inherit !important;
}
.hc__tile--1 .hud-stage__foot, .hc__tile--1 .hud-stage__rows > div, .hc__tile--1 .hud-panel__rows > div,
.hc__tile--2 .hud-stage__foot, .hc__tile--2 .hud-stage__rows > div, .hc__tile--2 .hud-panel__rows > div,
.hc__tile--3 .hud-stage__foot, .hc__tile--3 .hud-stage__rows > div, .hc__tile--3 .hud-panel__rows > div {
  justify-content: flex-end !important;
}
.hc__tile--4 .hud-stage__foot, .hc__tile--4 .hud-stage__rows > div, .hc__tile--4 .hud-panel__rows > div,
.hc__tile--5 .hud-stage__foot, .hc__tile--5 .hud-stage__rows > div, .hc__tile--5 .hud-panel__rows > div,
.hc__tile--6 .hud-stage__foot, .hc__tile--6 .hud-stage__rows > div, .hc__tile--6 .hud-panel__rows > div {
  justify-content: flex-start !important;
}
.hc__tile--1 .hud-stage__state, .hc__tile--2 .hud-stage__state, .hc__tile--3 .hud-stage__state,
.hc__tile--1 .hud-panel__state, .hc__tile--2 .hud-panel__state, .hc__tile--3 .hud-panel__state {
  justify-content: flex-end !important; flex-direction: row-reverse !important;
}

/* --- 2. bottom pair: full-width rows, no overlap ---------------------- */
.hc__grid { grid-template-rows: repeat(3, auto) auto auto !important; }
.hc__tile--7,
.hc__tile--8 {
  grid-column: 1 / -1 !important;
  justify-self: center !important;
  text-align: center !important;
  padding: 0 !important;
  max-width: min(560px, 84vw);
}
.hc__tile--7 { grid-row: 4 !important; --dx: 0px; --dy: 36px; margin-top: clamp(10px, 2vh, 26px); }
.hc__tile--8 { grid-row: 5 !important; --dx: 0px; --dy: 52px; }
.hc__tile--7 .hud-panel__rows, .hc__tile--8 .hud-panel__rows,
.hc__tile--7 .hud-stage__rows, .hc__tile--8 .hud-stage__rows {
  display: flex !important; flex-wrap: wrap; gap: 8px 22px !important; justify-content: center !important;
}
.hc__tile--7 .hud-panel__state, .hc__tile--8 .hud-panel__state,
.hc__tile--7 .hud-stage__state, .hc__tile--8 .hud-stage__state { justify-content: center !important; }
.hc__tile--7::after, .hc__tile--8::after {
  top: -14px; left: 50%; transform: translateX(-50%);
  width: 1px; height: 11px;
  background: linear-gradient(180deg, rgba(30,111,217,.12), var(--accent-70)) !important;
}
/* lift the device so it never sits on the bottom callouts */
.hc__device { transform:
  perspective(1500px)
  translateY(calc(var(--hp) * -7vh))
  rotateY(calc((0.5 - var(--hp)) * 16deg))
  scale(calc(1 + var(--hp) * 0.04)) !important; }

/* --- 3. bigger, bolder ------------------------------------------------ */
.hc__tile h4, .hc__tile .hud-t {
  font-size: 13px !important; font-weight: 700 !important;
  letter-spacing: .14em !important; color: var(--accent) !important;
  margin: 0 0 7px !important;
}
.hc__tile * { font-size: 15px !important; font-weight: 500 !important; color: var(--fg-70) !important; }
.hc__tile .hud-stage__figure b,
.hc__tile .hud-stage__title b,
.hc__tile .hud-panel__big,
.hc__tile b {
  font-family: var(--display) !important;
  font-size: clamp(22px, 2.1vw, 30px) !important;
  font-weight: 800 !important; color: var(--fg) !important;
  letter-spacing: -.018em !important; line-height: 1.12 !important;
}
.hc__tile .chip {
  font-size: 12px !important; font-weight: 600 !important;
  padding: 4px 9px !important; border-radius: 6px;
}
.hc__tile::after { height: 2px !important; top: 16px; }

/* ===========================================================================
   BACKGROUND — a light technical grid rather than flat white
   A 48px blueprint rule at 3.5% black, over a soft radial. It reads as
   engineering drawing paper, which suits a certification spec diagram, and
   it gives the white page some structure without adding colour.
   =========================================================================== */
.hc__media {
  background:
    linear-gradient(rgba(10,10,10,.038) 1px, transparent 1px) 0 0 / 48px 48px,
    linear-gradient(90deg, rgba(10,10,10,.038) 1px, transparent 1px) 0 0 / 48px 48px,
    radial-gradient(115% 85% at 50% 42%, #ffffff 0%, #f8fafc 52%, #eef1f6 100%) !important;
}
/* a soft halo behind the device so it separates from the grid */
.hc__media::after {
  content: ""; position: absolute; left: 50%; top: 46%;
  width: min(660px, 62vw); height: min(660px, 62vw);
  transform: translate(-50%, -50%);
  background: radial-gradient(circle, rgba(255,255,255,.96) 0%, rgba(255,255,255,.72) 38%, transparent 70%);
  pointer-events: none; z-index: 1;
}
.hc__device { z-index: 2; }

/* --- the aperture must clip the SCENE, not the callouts ---------------
   clip-path sat on .hc, which also contains the grid, the title and the
   tail - so as the aperture closed it sliced the flank labels in half.
   Moving it to .hc__media clips only the plate and the device; the callout
   diagram then sits on top, unclipped, exactly as a drawing overlay should. */
.hc { clip-path: none !important; }
.hc__media {
  clip-path: inset(var(--ins-y) var(--ins-x) var(--ins-y) var(--ins-x) round var(--rad)) !important;
  will-change: clip-path, transform, filter;
}

/* ===========================================================================
   ACT 3 — LAYOUT REBUILD
   The flank columns were 1fr of a 1440px grid, so each tile was ~488px wide.
   The HUD blocks are space-between flex rows, so their values stretched the
   full width and flew away from their own labels - SNAPDRAGON, 4,000 mAh and
   IP68 all ended up pinned to the far left edge.

   Fix: bound the columns, bound the tiles, and align every descendant to the
   edge the callout points from.
   =========================================================================== */

.hc__grid {
  grid-template-columns:
    minmax(0, 290px)
    minmax(200px, 300px)
    minmax(0, 290px) !important;
  grid-template-rows: repeat(3, auto) auto auto !important;
  justify-content: center !important;
  align-content: start !important;
  column-gap: clamp(20px, 3.4vw, 58px) !important;
  row-gap: clamp(6px, 1.4vh, 16px) !important;
  padding: clamp(92px, 13vh, 138px) clamp(16px, 3vw, 40px) clamp(20px, 3vh, 40px) !important;
}

.hc__tile {
  max-width: 290px !important;
  line-height: 1.35 !important;
}

/* --- alignment: every descendant follows the callout direction -------- */
.hc__tile--1, .hc__tile--1 *,
.hc__tile--2, .hc__tile--2 *,
.hc__tile--3, .hc__tile--3 * { text-align: right !important; }
.hc__tile--4, .hc__tile--4 *,
.hc__tile--5, .hc__tile--5 *,
.hc__tile--6, .hc__tile--6 * { text-align: left !important; }

.hc__tile--1 > div, .hc__tile--2 > div, .hc__tile--3 > div,
.hc__tile--1 .hud-stage__foot, .hc__tile--2 .hud-stage__foot, .hc__tile--3 .hud-stage__foot,
.hc__tile--1 .hud-stage__state, .hc__tile--2 .hud-stage__state, .hc__tile--3 .hud-stage__state,
.hc__tile--1 .hud-stage__figure, .hc__tile--2 .hud-stage__figure, .hc__tile--3 .hud-stage__figure,
.hc__tile--1 .hud-stage__title, .hc__tile--2 .hud-stage__title, .hc__tile--3 .hud-stage__title,
.hc__tile--1 .chips, .hc__tile--2 .chips, .hc__tile--3 .chips,
.hc__tile--1 .hud-stage__rows > div, .hc__tile--2 .hud-stage__rows > div, .hc__tile--3 .hud-stage__rows > div {
  display: flex !important;
  flex-direction: row !important;
  flex-wrap: wrap !important;
  justify-content: flex-end !important;
  align-items: baseline !important;
  gap: 4px 8px !important;
}
.hc__tile--4 > div, .hc__tile--5 > div, .hc__tile--6 > div,
.hc__tile--4 .hud-stage__foot, .hc__tile--5 .hud-stage__foot, .hc__tile--6 .hud-stage__foot,
.hc__tile--4 .hud-stage__state, .hc__tile--5 .hud-stage__state, .hc__tile--6 .hud-stage__state,
.hc__tile--4 .hud-stage__figure, .hc__tile--5 .hud-stage__figure, .hc__tile--6 .hud-stage__figure,
.hc__tile--4 .hud-stage__title, .hc__tile--5 .hud-stage__title, .hc__tile--6 .hud-stage__title,
.hc__tile--4 .chips, .hc__tile--5 .chips, .hc__tile--6 .chips,
.hc__tile--4 .hud-stage__rows > div, .hc__tile--5 .hud-stage__rows > div, .hc__tile--6 .hud-stage__rows > div {
  display: flex !important;
  flex-direction: row !important;
  flex-wrap: wrap !important;
  justify-content: flex-start !important;
  align-items: baseline !important;
  gap: 4px 8px !important;
}
/* the panel/stage row lists stack, they should not become one long line */
.hc__tile .hud-stage__rows, .hc__tile .hud-panel__rows {
  display: grid !important; gap: 2px !important;
}

/* --- tighter type so a callout is two or three lines, not five -------- */
.hc__tile h4, .hc__tile .hud-t {
  font-size: 12px !important; margin: 0 0 4px !important; letter-spacing: .12em !important;
}
.hc__tile * { font-size: 14px !important; }
.hc__tile .hud-stage__figure b,
.hc__tile .hud-stage__title b,
.hc__tile .hud-panel__big,
.hc__tile b {
  font-size: clamp(20px, 1.7vw, 26px) !important; line-height: 1.1 !important;
}
.hc__tile .chip { font-size: 11px !important; padding: 3px 7px !important; }

/* --- bottom pair: one row, side by side, under the device ------------- */
.hc__tile--7, .hc__tile--8 {
  grid-row: 4 !important;
  max-width: none !important;
  justify-self: stretch !important;
  margin-top: clamp(6px, 1.4vh, 16px);
}
.hc__tile--7 { grid-column: 1 / 3 !important; text-align: right !important; padding-right: 18px !important; }
.hc__tile--8 { grid-column: 3 / -1 !important; text-align: left  !important; padding-left: 18px !important; }
.hc__tile--7 *, .hc__tile--7 .hud-panel__rows > div { text-align: right !important; justify-content: flex-end !important; }
.hc__tile--8 *, .hc__tile--8 .hud-panel__rows > div { text-align: left  !important; justify-content: flex-start !important; }
.hc__tile--7 .hud-panel__rows, .hc__tile--8 .hud-panel__rows {
  display: flex !important; flex-wrap: wrap; gap: 4px 14px !important;
}
.hc__tile--7::after, .hc__tile--8::after {
  top: 16px; width: clamp(18px, 2.6vw, 40px) !important; height: 2px !important;
  left: auto; transform: none;
}
.hc__tile--7::after { right: 0; background: linear-gradient(90deg, var(--accent-70), rgba(30,111,217,.12)) !important; }
.hc__tile--8::after { left: 0;  background: linear-gradient(270deg, var(--accent-70), rgba(30,111,217,.12)) !important; }

/* --- the tail sits below everything, never over it -------------------- */
.hc__tail {
  position: absolute !important;
  bottom: calc(36px + clamp(14px, 2.4vh, 30px)) !important;
  gap: 10px !important;
}
.hc__lede { font-size: 14px !important; line-height: 1.45 !important; max-width: 640px; }
@media (max-height: 940px) { .hc__lede { display: none !important; } }

/* the device drops back to centre now the callouts flank it rather than
   stack under it */
.hc__device { transform:
  perspective(1500px)
  translateY(calc(var(--hp) * -3vh))
  rotateY(calc((0.5 - var(--hp)) * 16deg))
  scale(calc(1 + var(--hp) * 0.04)) !important; }

/* --- bottom pair: centred UNDER the device, not through it ------------
   Spanning grid columns 1/3 put the right-aligned Certification Status text
   at the right edge of the device column - i.e. behind the phone. Taking the
   pair out of grid flow and anchoring them either side of centre, below the
   device, is both cleaner and immune to how the rows above happen to size. */
.hc__tile--7, .hc__tile--8 {
  position: absolute !important;
  grid-row: auto !important; grid-column: auto !important;
  top: auto !important;
  bottom: clamp(104px, 14vh, 152px) !important;
  width: min(290px, 33vw) !important;
  max-width: none !important;
  margin: 0 !important;
  padding: 0 !important;
}
.hc__tile--7 { right: 50% !important; margin-right: clamp(18px, 2.6vw, 38px) !important; text-align: right !important; }
.hc__tile--8 { left:  50% !important; margin-left:  clamp(18px, 2.6vw, 38px) !important; text-align: left  !important; }

.hc__tile--7 *, .hc__tile--7 .hud-panel__rows > div,
.hc__tile--7 .hud-panel__state { text-align: right !important; justify-content: flex-end !important; }
.hc__tile--8 *, .hc__tile--8 .hud-panel__rows > div,
.hc__tile--8 .hud-panel__state { text-align: left  !important; justify-content: flex-start !important; }

.hc__tile--7 .hud-panel__rows, .hc__tile--8 .hud-panel__rows {
  display: flex !important; flex-wrap: wrap; gap: 3px 12px !important;
}
.hc__tile--7 .hud-panel__rows { justify-content: flex-end !important; }
.hc__tile--8 .hud-panel__rows { justify-content: flex-start !important; }

/* connector rules point up toward the device */
.hc__tile--7::after, .hc__tile--8::after {
  top: -13px !important; bottom: auto !important;
  width: 2px !important; height: 10px !important;
  background: linear-gradient(180deg, rgba(30,111,217,.12), var(--accent-70)) !important;
}
.hc__tile--7::after { right: 0 !important; left: auto !important; }
.hc__tile--8::after { left:  0 !important; right: auto !important; }

@media (max-width: 900px) {
  .hc__tile--7, .hc__tile--8 {
    position: relative !important; bottom: auto !important;
    right: auto !important; left: auto !important;
    width: auto !important; margin: 0 !important;
    text-align: left !important;
  }
}

/* --- title clearance --------------------------------------------------
   The closing title ran from 139 to 216 while the first callout row sat at
   117-189, so they overlapped. Title moves up under the navbar and the grid
   starts below it. */
.hc__title {
  top: clamp(92px, 11vh, 106px) !important;
  width: min(560px, 52vw) !important;
  font-size: clamp(20px, 2vw, 28px) !important;
}
.hc__grid { padding-top: clamp(176px, 22vh, 200px) !important; }

/* ===========================================================================
   THE PHONE MUST FIT INSIDE THE APERTURE
   At 1440x900 the closed aperture was 294px tall while the device was 305px
   and lifted 29px by its translate - so the top of the phone was cut off.
   The aperture opens up, the device comes down, and the lift is removed.
   =========================================================================== */
.hc {
  --ins-y: calc(var(--hp) * 23%) !important;   /* was 31% */
  --ins-x: calc(var(--hp) * 33%) !important;   /* was 35% */
}
.hc__device {
  width:  clamp(128px, 15.4vh, 186px) !important;
  height: clamp(240px, 29vh, 350px) !important;
  transform:
    perspective(1500px)
    rotateY(calc((0.5 - var(--hp)) * 16deg))
    scale(calc(1 + var(--hp) * 0.03)) !important;   /* no vertical lift */
}

/* ---------------------------------------------------------------------
   The lede is the last thing to fit and the first to collide with the
   bottom callouts. It only shows when there is genuinely room for it. */
@media (max-height: 1000px) { .hc__lede { display: none !important; } }

/* keep a hard floor under the callouts so they can never reach the CTAs */
.hc__tile--7, .hc__tile--8 { bottom: clamp(118px, 15vh, 168px) !important; }

/* the aperture now has 93px of slack top and bottom - give it back to the
   product, which is the thing the diagram is about */
.hc__device {
  width:  clamp(139px, 18.1vh, 213px) !important;   /* 722/1356 = 0.532 */
  height: clamp(261px, 34vh, 400px) !important;
}
